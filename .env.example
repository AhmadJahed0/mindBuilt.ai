# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider (needed once you're ready to test real chat/embeddings) ---
# Pick ONE provider for local dev. Production uses Azure OpenAI in the
# client's own tenant per the architecture doc — this is just for testing.
LLM_PROVIDER=openai          # openai | azure | anthropic | local

# If LLM_PROVIDER=openai
OPENAI_API_KEY=

# If LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# If LLM_PROVIDER=local — Ollama running on the HOST machine (not in
# Docker, so it gets real GPU/Metal/MLX acceleration). Install with
# `brew install ollama`, `brew services start ollama`, then
# `ollama pull llama3.1:8b` before using this.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
# Independent of LLM_PROVIDER on purpose — the embedding model can be
# swapped on its own.
EMBEDDING_PROVIDER=openai    # openai | azure | local
EMBEDDING_MODEL=text-embedding-3-small
# If EMBEDDING_PROVIDER=local — downloaded once from Hugging Face on
# first use, then cached. No API key needed.
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- File storage (architecture doc Section 1.3) ---
# local works immediately with zero setup (a Docker volume). supabase is
# the real cloud backend — needs a Supabase project (supabase.com), a
# storage bucket, and these three values before it'll run.
STORAGE_PROVIDER=local        # local | supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
